{
  "name": "rider-call",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "rider-call-signal", "database_id": "82d5bf78-466c-4f52-8261-3232a945f6e7" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "routes": [{ "pattern": "call.pooban.ir", "custom_domain": true }],
  "observability": { "enabled": true }
}
